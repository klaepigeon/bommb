; Engine configuration file.
; MEAT PARTY - Godot 4.7

config_version=5

[application]

config/name="LAST CALL 3"
config/version="3.0.0"
config/description="LAST CALL 3: MEAT PARTY. A four-player survival party game hosted by The Caller."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[audio]

driver/enable_input=false

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Content="*res://scripts/lcc/content.gd"
Sfx="*res://scripts/lcc/sfx.gd"
Profile="*res://scripts/lcc/profile.gd"
Assets="*res://scripts/autoload/assets.gd"
Audio="*res://scripts/autoload/audio.gd"
Seats="*res://scripts/autoload/seats.gd"
Net="*res://scripts/net/net.gd"
Lighting="*res://scripts/visual/lamp_field.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[meat_party]

net/relay_url="wss://lc3onlinebeta.onrender.com"
net/enet_port=24510
net/lan_discovery_port=24511

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.07, 0.04, 0.09, 1)
limits/opengl/max_renderable_lights=64
limits/opengl/max_lights_per_object=16

[shader_globals]

lamp_data={
"type": "sampler2D",
"value": ""
}
lamp_count={
"type": "int",
"value": 0
}
moon_dir={
"type": "vec3",
"value": Vector3(0.45, -0.75, 0.5)
}
moon_color={
"type": "color",
"value": Color(0.4, 0.4, 0.56, 1)
}
ambient_color={
"type": "color",
"value": Color(0.5, 0.43, 0.56, 1)
}
ink_color={
"type": "color",
"value": Color(0.09, 0.06, 0.15, 1)
}
retro={
"type": "float",
"value": 1.0
}
saturation={
"type": "float",
"value": 1.15
}
grade={
"type": "float",
"value": 0.12
}
halftone={
"type": "float",
"value": 0.0
}
detail={
"type": "float",
"value": 1.0
}

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false
}

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
