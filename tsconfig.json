{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "useUnknownInCatchVariables": false,
    "allowJs": false,
    "types": []
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
