; NIGHT PEOPLE. Godot 4.7, GL Compatibility on every platform (Android first).
config_version=5

[application]

config/name="NIGHT PEOPLE"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
config/version="0.1"
run/flush_stdout_on_print=true

[autoload]

Settings="*res://core/settings.gd"
Events="*res://core/events.gd"
Clock="*res://core/clock.gd"
Assets="*res://core/assets.gd"
World="*res://core/world.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="doors"
3d_physics/layer_5="interactable"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
limits/opengl/max_lights_per_object=16
shading/overrides/force_vertex_shading=true
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)

[shader_globals]

ps1_snap={
"type": "float",
"value": 160.0
}
ps1_affine={
"type": "float",
"value": 0.35
}
