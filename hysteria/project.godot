; HYSTERIA — Godot 4.7 project (GL Compatibility: one renderer for PC and Android)
config_version=5

[application]

config/name="HYSTERIA"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/handheld/orientation=4

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.81

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

; headroom over the flat's worst mesh (6 omni + 5 spot): Compatibility silently drops the rest
limits/opengl/max_lights_per_object=16

; Android: the mobile defaults are 16-bit, half-size, unfiltered shadow maps, which on Adreno and
; Mali shimmer and acne as the camera (and the PS1 vertex snapping) moves. Same shadows as desktop.
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/atlas_size.mobile=4096
lights_and_shadows/positional_shadow/atlas_16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=2

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0

[shader_globals]

hole_min={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
hole_max={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
