; HYSTERIA, Android-first rebuild. Godot 4.7, GL Compatibility on every platform.
config_version=5

[application]

config/name="HYSTERIA"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
run/flush_stdout_on_print=true

[autoload]

Settings="*res://scripts/core/settings.gd"
Game="*res://scripts/core/game.gd"
Noises="*res://scripts/core/noise.gd"
Sfx="*res://scripts/core/sfx.gd"
Speech="*res://scripts/core/speech.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

limits/opengl/max_lights_per_object=16

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=1024
