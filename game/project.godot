; HYSTERIA — Flat 47, rebuilt (Godot 4.7, GL Compatibility everywhere: the phone's renderer is the only renderer).
; Lighting is the game's own (scripts/render/lights.gd + shaders/world.gdshaderinc): no Light3D nodes at all.
config_version=5

[application]

config/name="HYSTERIA"
config/icon="res://icon/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
config/version="1.0"
run/flush_stdout_on_print=true

[autoload]

Log="*res://scripts/core/log.gd"
Settings="*res://scripts/core/settings.gd"
World="*res://scripts/core/world.gd"
Lights="*res://scripts/render/lights.gd"
Noises="*res://scripts/core/noise.gd"
Audio="*res://scripts/core/audio.gd"
Controls="*res://scripts/ui/controls.gd"
Power="*res://scripts/sim/power.gd"
Speech="*res://scripts/core/speech.gd"
Progress="*res://scripts/core/progress.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=256
lights_and_shadows/positional_shadow/atlas_size=256
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
gl_compatibility/item_buffer_size=16384

[shader_globals]

l0_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
l0_col={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
l0_zone={
"type": "vec4",
"value": Vector4(-2, -2, -2, -2)
}
