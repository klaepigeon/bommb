 "dialogue": [
  {
   "id": "title_idle",
   "chance": 0.5,
   "lines": [
    "You. Have returned.",
    "Sit. Sit-sit. There.",
    "The hall is open. The hall is al-always open.",
    "Eyes down. Pens re-ready.",
    "I am... the Caller. I will be all of them.",
    "Sit. The dice. Are warm.",
    "Not yet. Sit.",
    "Friday. It is always. Friday.",
    "Your chair. I kept it. Dusted.",
    "Coats on the hooks. Nobody needs. Coats.",
    "Pens. Cards. Faces. Eyes down."
   ]
  },
  {
   "id": "new_campaign",
   "gesture": "spread",
   "lines": [
    "A new campaign. Four Books.",
    "Choose four. Any four. The dead may also play.",
    "We play until. Until. Until it is finished."
   ]
  },
  {
   "id": "party_chosen",
   "gesture": "tap",
   "lines": [
    "Good. The miniatures go on the board.",
    "Four. I will learn their n-names. Then forget them.",
    "It is decided. No one leaves the table."
   ]
  },
  {
   "id": "book_start",
   "look": true,
   "gesture": "spin",
   "lines": [
    "Turn the page.",
    "A new Book. [whirr] Begin.",
    "Chapter. Next chapter.",
    "Page one. Again. Page one.",
    "A new Book. Same table.",
    "Open it. Gently. The spine. Is old.",
    "I wrote this one. At night. [whirr]",
    "Turn. Turn the page. Do not. Skip."
   ]
  },
  {
   "id": "map_choose",
   "chance": 0.25,
   "cooldown": 4,
   "lines": [
    "Choose a page.",
    "Where will you go. Choose.",
    "Left. Or right. Either is... a choice.",
    "Every road. Comes back here.",
    "Pick. I will. Pretend. To be surprised.",
    "That way is wet. That way is wet too.",
    "Point. With your finger. Not. Your eyes.",
    "Careful. Some pages. Are stuck together."
   ]
  },
  {
   "id": "enter_combat",
   "chance": 0.3,
   "cooldown": 2,
   "gesture": "tap",
   "lines": [
    "Positions.",
    "Let us begin.",
    "The pieces are on the board.",
    "Initiative. Ro-rolled. Already.",
    "Eyes down.",
    "Pieces. On the felt.",
    "Roll. For. Who goes first. I know who.",
    "They have been. Waiting. In the box.",
    "Hands where I. Can count them. Begin."
   ]
  },
  {
   "id": "enter_elite",
   "look": true,
   "gesture": "point",
   "lines": [
    "This one is larger.",
    "A difficult piece. I painted it m-myself.",
    "Be careful. This one bites. Bites.",
    "I keep this one. In the good box.",
    "Big. Big piece. Mind your fingers.",
    "This one. Has a name. I will not. Say it.",
    "Two hands to lift it. I. Have. Two.",
    "Larger. Hungrier. Painted. Wet."
   ]
  },
  {
   "id": "enter_boss",
   "look": true,
   "gesture": "spread",
   "lines": [
    "Now. The main event.",
    "Lights. Down.",
    "This is the part. The part people re-remember.",
    "Everyone. Quiet now.",
    "The big number. Coming up.",
    "House lights. Off.",
    "I have been. Saving this. For you.",
    "Sit up. Straight. This one. Watches."
   ]
  },
  {
   "id": "crit_hero",
   "chance": 0.45,
   "cooldown": 3,
   "lines": [
    "Twenty.",
    "A twenty. Hm.",
    "Well rolled.",
    "Lucky. Lucky-lucky.",
    "Top of the shop.",
    "Twenty. I. Will remember. That.",
    "Hm. Hmm. Good. Hand.",
    "Nobody. Rolls. Like that. Here.",
    "Lucky. For now. For now."
   ]
  },
  {
   "id": "crit_enemy",
   "chance": 0.45,
   "cooldown": 3,
   "gesture": "tap",
   "lines": [
    "Twenty. For me.",
    "That will hurt.",
    "Oh. Oh no. For you.",
    "Twenty. Mine. All mine.",
    "Oh. That is. A lot of. Damage.",
    "The die. Agrees. With me.",
    "Lovely. Lovely number.",
    "Sorry. Not. Sorry."
   ]
  },
  {
   "id": "fumble_hero",
   "chance": 0.4,
   "cooldown": 3,
   "lines": [
    "One.",
    "A one. Noted.",
    "The die does not like you.",
    "Kelly's eye. One.",
    "One. Kelly's eye. Again.",
    "Dropped. It. Off the table.",
    "Ones. Always ones. Here.",
    "The die. Remembers. What you did.",
    "Unlucky. For. Some."
   ]
  },
  {
   "id": "fumble_enemy",
   "chance": 0.35,
   "cooldown": 3,
   "lines": [
    "One. Unfortunate.",
    "My piece dropped it.",
    "...I will pretend I did not see that.",
    "Clumsy. My fault. Not his.",
    "He slipped. I will. Repaint. Him.",
    "No. No. Do not. Look.",
    "The felt. Is. Uneven there.",
    "...Ignore. That. One."
   ]
  },
  {
   "id": "hero_down",
   "chance": 0.7,
   "cooldown": 1,
   "look": false,
   "lines": [
    "Down.",
    "Your piece is down. Not out. Not yet.",
    "Three saves. I will count them. I count.",
    "Lie still. I will. Count.",
    "On the floor. Like. The others.",
    "Down. Down. Not. Gone.",
    "Someone. Pick them up. Or. Do not.",
    "Hm. That one. Bleeds. On my felt."
   ]
  },
  {
   "id": "hero_death",
   "look": true,
   "gesture": "lean",
   "lines": [
    "Gone.",
    "I will keep their card. I keep all the cards.",
    "Their name goes in the book.",
    "One fewer at the table.",
    "Coat off the hook. Coat. On the peg.",
    "They are staying. Now.",
    "I will save. Their seat.",
    "Ink. Not pencil. For that one.",
    "One more. Regular.",
    "Shh. Shh. They are. Comfortable."
   ]
  },
  {
   "id": "victory",
   "chance": 0.4,
   "cooldown": 2,
   "lines": [
    "It appears you have won.",
    "Clear the board.",
    "Back in the box. All of them.",
    "Box them up. Gently.",
    "Board clear. For now.",
    "Good. Good. Next page.",
    "Sweep the dice. Count them. All there.",
    "You. Won. That. One."
   ]
  },
  {
   "id": "elite_victory",
   "lines": [
    "The large one is down. Impressive.",
    "I will repaint it. It will re-return.",
    "My good piece. Broken.",
    "I will glue. It. Back.",
    "Hm. I. Liked. That one.",
    "Down. It took. Three coats of paint.",
    "Fine. Fine. Fine."
   ]
  },
  {
   "id": "boss_victory",
   "look": true,
   "gesture": "spread",
   "lines": [
    "You... won. I did not plan for that.",
    "The Book is finished.",
    "Full house. Collect your p-prize.",
    "The Book. Closes. Not the hall.",
    "House. You. Called it. Not me.",
    "Clap. [clap] Clap.",
    "Prize. Prize. At the counter.",
    "Well. Well. Another. Book."
   ]
  },
  {
   "id": "defeat",
   "look": true,
   "gesture": "lean",
   "lines": [
    "And that is the game.",
    "No one left. I will clean up.",
    "Again. We will play again. Same time. Same time. Same t-",
    "Nobody. Left. Lights down.",
    "I will stack the chairs.",
    "That is a full house. For me.",
    "Same time. Next week. Same. Time.",
    "Sit. Sit. You can. Stay. Now."
   ]
  },
  {
   "id": "run_won",
   "look": true,
   "gesture": "spread",
   "lines": [
    "You finished it. No one finishes it.",
    "That was the last page. I think. I am checking. [click]"
   ]
  },
  {
   "id": "new_run_after_loss",
   "chance": 1.0,
   "lines": [
    "You came back. They all come back.",
    "The last ones did not make it. Sit."
   ]
  },
  {
   "id": "event_start",
   "chance": 0.2,
   "cooldown": 3,
   "lines": [
    "Something on this page.",
    "Listen. I will read it once.",
    "Hush. Read this.",
    "A page. I. Wrote. Myself.",
    "Something. Here. Is not. On the map.",
    "Listen. Once. I will. Not. Repeat.",
    "This bit. Is true."
   ]
  },
  {
   "id": "shop_enter",
   "persona": "prize_clerk",
   "lines": [
    "Prizes. Tickets or gold.",
    "Look. Do not touch. Touch. Buy.",
    "Everything has a price. Everything.",
    "Prizes. One each. One.",
    "A bear. A radio. A ham. And these.",
    "Honest prices. Honest. Mostly.",
    "No refunds. They never. Come back.",
    "Pick a prize. Not the die. That is reserved."
   ]
  },
  {
   "id": "rest_enter",
   "persona": "nurse",
   "lines": [
    "Sit. Before you fall.",
    "Rest. I will wake you.",
    "Bandages. On the left.",
    "Feet up. Head down.",
    "Plasters. Tea. In that order.",
    "Hold still. I will. Count. Your. Breaths.",
    "Sleep. He will. Not. Move the board.",
    "Bed. Blanket. Nobody. Checks under."
   ]
  },
  {
   "id": "gambit_offer",
   "persona": "auctioneer",
   "look": true,
   "gesture": "point",
   "lines": [
    "A new rule. Going cheap. Ch-cheap.",
    "Two rules. Take one.",
    "Lot seven. A small change. Small. For me."
   ]
  },
  {
   "id": "gambit_accept",
   "persona": "auctioneer",
   "lines": [
    "Sold.",
    "Going. Going. Gone."
   ]
  },
  {
   "id": "gambit_refuse",
   "persona": "auctioneer",
   "lines": [
    "No sale. Noted.",
    "Your loss."
   ]
  },
  {
   "id": "relic_found",
   "chance": 0.6,
   "lines": [
    "Ah. That is where that went.",
    "Someone left that. Someone always does.",
    "Yours now.",
    "That was. Somebody's.",
    "Lost property. Now. Yours.",
    "Keep it. They. Will not. Ask.",
    "Pocket it. Quickly.",
    "Oh. I. Wondered. Where."
   ]
  },
  {
   "id": "level_up",
   "chance": 0.5,
   "cooldown": 2,
   "lines": [
    "They are getting better. I will adjust.",
    "Stronger. Hm.",
