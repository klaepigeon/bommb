{
 "rule_cards": [
  {
   "id": "rc_blind_mans_bluff",
   "name": "Blind Man's Bluff",
   "fights": 3,
   "desc": "For 3 fights he watches 30% less, but every cheat adds twice as much to the FILE.",
   "mods": [
    {
     "key": "watch_mult",
     "op": "mul",
     "value": 0.7
    },
    {
     "key": "cheat_suspicion",
     "op": "mul",
     "value": 2.0
    }
   ]
  },
  {
   "id": "rc_open_hand",
   "name": "Open Hand",
   "fights": 2,
   "desc": "For 2 fights no cheat can be caught. The FILE fills twice as fast.",
   "mods": [
    {
     "key": "cheat_safe",
     "op": "set",
     "value": true
    },
    {
     "key": "cheat_suspicion",
     "op": "mul",
     "value": 2.0
    }
   ]
  },
  {
   "id": "rc_drinking_game",
   "name": "Drinking Game",
   "fights": 3,
   "desc": "For 3 fights every sip heals every hero 3 and adds 2 to the FILE.",
   "triggers": [
    {
     "event": "sip",
     "effects": [
      {
       "type": "heal",
       "dice": "3",
       "to": "all_heroes"
      },
      {
       "type": "suspicion",
       "n": 2
      }
     ],
     "label": "Drinking Game",
     "quiet": true
    }
   ]
  },
  {
   "id": "rc_even_steven",
   "name": "Even Steven",
   "fights": 3,
   "desc": "For 3 fights a hero's natural 10 empowers them; a natural 5 or lower weakens them.",
   "triggers": [
    {
     "event": "natural",
     "effects": [
      {
       "type": "status",
       "id": "empowered",
       "turns": 1,
       "to": "self"
      }
     ],
     "when": {
      "side": "hero",
      "natural": 10
     },
     "label": "Even Steven",
     "quiet": true
    },
    {
     "event": "natural",
     "when": {
      "side": "hero",
      "natural_le": 5
     },
     "effects": [
      {
       "type": "status",
       "id": "weakened",
       "turns": 1,
       "to": "self"
      }
     ],
     "label": "Even Steven",
     "quiet": true
    }
   ]
  },
  {
   "id": "rc_last_mini_standing",
   "name": "Last Mini Standing",
   "fights": -1,
   "desc": "For the rest of the campaign: a hero with no allies next to them deals +3 damage. Heroes next to each other take +1.",
   "mods": [
    {
     "key": "damage_dealt_add",
     "op": "add",
     "value": 3,
     "when": {
      "side": "hero",
      "alone": true
     }
    },
    {
     "key": "damage_taken_add",
     "op": "add",
     "value": 1,
     "when": {
      "side": "hero",
      "alone": false
     }
    }
   ]
  },
  {
