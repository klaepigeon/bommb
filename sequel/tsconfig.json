{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": [
    "src/engine/**/*.ts",
    "src/ship/**/*.ts",
    "src/space/system.ts",
    "src/gfx/**/*.ts",
    "../types/rhapsody.d.ts"
  ]
}
